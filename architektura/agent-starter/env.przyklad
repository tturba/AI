# Skopiuj jako .env i uzupełnij tylko to, czego używasz. Plik .env jest w .gitignore,
# a agent nie może go czytać (reguła deny i hook straz.py).
# Zmienne muszą trafić do środowiska powłoki, z której startuje agent, na przykład:
#   set -a; . ./.env; set +a; claude

# Context7: opcjonalny klucz, bez niego serwer działa z niższym limitem zapytań
CONTEXT7_API_KEY=

# GitHub MCP: token o najwęższym zakresie, najlepiej tylko do odczytu
GITHUB_PAT=

# Brave Search MCP
BRAVE_API_KEY=
